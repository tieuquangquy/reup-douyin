APP_ENV=local
DATABASE_URL=postgresql://reup_douyin:reup_douyin@localhost:5432/reup_douyin
DBNET_ONNX_PROVIDER=auto
REDIS_URL=redis://localhost:6379/0
# Must resolve to the same repository storage root as apps/api when dev-start
# launches the worker from apps/worker.
LOCAL_STORAGE_ROOT=../../data/storage
# Analyze Audio V4 uses a pinned local YAMNet ONNX model. Leave the path empty
# to resolve it under LOCAL_STORAGE_ROOT/.models/audio_event/yamnet_f25b741c.
AUDIO_EVENT_YAMNET_ENABLED=true
# AUDIO_EVENT_YAMNET_MODEL_PATH=
METRICS_COLLECTION_MAX_CONCURRENT_RUNNING=2
CLASSIFICATION_MAX_CONCURRENT_RUNNING=2
METRICS_COLLECTION_STALE_RUNNING_SECONDS=300
CLASSIFICATION_STALE_RUNNING_SECONDS=1800
METRICS_COLLECTION_RETRY_BACKOFF_BASE_SECONDS=60
METRICS_COLLECTION_RETRY_BACKOFF_MAX_SECONDS=3600
METRICS_COLLECTION_RATE_LIMIT_COOLDOWN_SECONDS=900
METRICS_SCHEDULER_ENABLED=true
METRICS_SCHEDULER_SWEEP_INTERVAL_SECONDS=60
METRICS_SCHEDULER_DISPATCH_LIMIT=20
# Douyin video download (Reup Queue START_PROCESSING) uses yt-dlp to resolve HQ/no-logo streams.
# Install yt-dlp on PATH for the worker host: pip install yt-dlp
DOUYIN_YT_DLP_ENABLED=true
DOUYIN_YT_DLP_BINARY=yt-dlp
DOUYIN_YT_DLP_FORMAT=bestvideo*[height<=1920][vcodec!*=hevc][vcodec!*=av01]+bestaudio/bestvideo*[height<=1920]+bestaudio/best[height<=1920]/best
DOUYIN_YT_DLP_TIMEOUT_SECONDS=900
DOUYIN_YT_DLP_FAST_PATH_TIMEOUT_SECONDS=90
DOUYIN_YT_DLP_FIRST_BYTE_TIMEOUT_SECONDS=45
DOUYIN_YT_DLP_STALL_TIMEOUT_SECONDS=90
# Prefer live/store cookies from connected Douyin browser profile over DOUYIN_SESSION_COOKIE.
# The cookie store defaults to repo .douyin_profiles/download_cookies and must be
# readable by both API and worker; override the same path in both processes if needed.
DOUYIN_YT_DLP_PREFER_BROWSER_COOKIES=true
# Cheap cookie-backed yt-dlp first; strict no-logo validation still gates output.
DOUYIN_DOWNLOAD_PREFER_YT_DLP_FAST_PATH=true
# Optional shared cookie-store override:
# DOUYIN_DOWNLOAD_COOKIE_STORE_DIR=
# Maximum accepted source payload. Resolver adapters must enforce this before
# promotion; ffprobe/size/SHA-256 still gate the authoritative MediaAsset.
DOUYIN_DOWNLOAD_MAX_BYTES=2000000000
DOUYIN_DOWNLOAD_QUALITY_PROFILE=balanced_processing
DOUYIN_DOWNLOAD_TARGET_LONG_EDGE=1920
# Only incomplete managed staging is expired; authoritative storage is untouched.
DOUYIN_DOWNLOAD_STAGING_TTL_HOURS=24
DOUYIN_DOWNLOAD_CACHE_DEEP_VERIFY_INTERVAL_HOURS=24
DOUYIN_PLAYWRIGHT_DOWNLOAD_ENABLED=true
DOUYIN_PLAYWRIGHT_DOWNLOAD_AUTO_OPEN=true
DOUYIN_PLAYWRIGHT_DOWNLOAD_HEADLESS=true
# Strict HQ/no-logo default. Enable only when an operator accepts platform logos.
DOUYIN_DOWNLOAD_ALLOW_WATERMARKED_FALLBACK=false
DOUYIN_PLAYWRIGHT_DOWNLOAD_TIMEOUT_MS=90000
DOUYIN_PLAYWRIGHT_MEDIA_SETTLE_TIMEOUT_MS=2500
# Optional managed staging override (default: repo .douyin_profiles/download_staging_v2).
# Keep API and worker values identical when set.
# DOUYIN_DOWNLOAD_STAGING_DIR=
# Deprecated alias retained for older profiles; prefer DOUYIN_DOWNLOAD_STAGING_DIR.
# DOUYIN_PLAYWRIGHT_DOWNLOAD_STAGING_DIR=
DOUYIN_DOWNLOAD_API_BASE_URL=http://127.0.0.1:8000
# Do not spend the full browser timeout when a verified clean fallback already exists.
DOUYIN_DOWNLOAD_QUALITY_ESCALATION_TIMEOUT_SECONDS=45
# If overridden, keep these retry/concurrency values aligned with apps/api.
# DOUYIN_DOWNLOAD_TRANSIENT_MAX_ATTEMPTS=8
# DOUYIN_DOWNLOAD_AUTH_MAX_ATTEMPTS=2
# DOUYIN_DOWNLOAD_RETRY_BACKOFF_BASE_SECONDS=5
# DOUYIN_DOWNLOAD_RETRY_BACKOFF_MAX_SECONDS=120
# Match the default two worker processes. Playwright browser transfers still serialize.
DOWNLOAD_VIDEO_MAX_CONCURRENT_RUNNING=2
# Leave unset to derive a safe stale threshold from resolver timeouts.
# DOWNLOAD_VIDEO_STALE_RUNNING_SECONDS=600
DOUYIN_PERSISTENT_BROWSER_PROFILE_ENABLED=true
DOUYIN_PERSISTENT_BROWSER_PROFILES_ROOT_DIR=./data/browser-profiles/douyin
WORKER_CONCURRENCY=1
# A worker runs one job at a time, so a long render blocks downloads behind it. Run several
# worker processes instead: scripts/dev-start.ps1 starts WORKER_COUNT of them (default 2)
# and the GPU budget (GPU_MAX_CONCURRENT_RUNNING in apps/api) keeps one heavy job on the
# card. Each worker loads its own model copies, so more workers cost RAM.
# WORKER_COUNT=2
# Leave WORKER_ID unset to get a per-process id (local-worker-<pid>). Crash recovery
# requeues jobs by locked_by, so two processes must never share the same id.
# WORKER_ID=local-worker-1
WORKER_POLL_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

# Phase 2 OCR (ANALYZE_OCR) — same /predict URL as API (Local or Cloud).
# Switch by OCR_ENDPOINT_URL only; restart worker after change.
#
# LOCAL ($0): powershell -ExecutionPolicy Bypass -File deploy/hf-paddle-ocr/run_local.ps1
# OCR_ENDPOINT_URL=http://127.0.0.1:8080/predict
#
# CLOUD (optional): python deploy/hf-paddle-ocr/auto_deploy.py
# OCR_ENDPOINT_URL=https://paddle-ocr-api-xxxxx-xx.a.run.app/predict
#
# Best quality profile (recommended):
# OCR_QUALITY_PROFILE=best
# OCR_ASYNC_CONCURRENCY=2
# OCR_PREPROCESS_MAX_EDGE=1920
# OCR_JPEG_QUALITY=92
# OCR_CROP_BAND=1
# OCR_FRAME_BACKEND=text_onnx
# SKE crop OCR: OCR_FRAME_BACKEND=ske  (fallback text_onnx; skipped when OCR_QUALITY_PROFILE=best)
# OCR_RENDER_BACKEND=opencv_inpaint
# Rollback: OCR_RENDER_BACKEND=ffmpeg_delogo

# Used by CRAWL_PROFILE worker jobs. Keep disabled unless the local operator
# has network/session access that can fetch public Douyin profile pages.
DOUYIN_ENABLE_LIVE_FETCH=false
DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
DOUYIN_SESSION_COOKIE=
DOUYIN_PROXY_URL=
DOUYIN_FETCH_TIMEOUT_SECONDS=15
DOUYIN_FETCH_MAX_VIDEOS=50

# Localization ANALYZE_AUDIO (shared settings with API when using same DATABASE_URL).
# AUDIO_STT_PROVIDER=funasr
# AUDIO_FUNASR_TIMEOUT_SECONDS=180
# AUDIO_FUNASR_WARMUP_TIMEOUT_SECONDS=900
# AUDIO_FUNASR_CHUNK_SECONDS=60
# AUDIO_FUNASR_CHUNK_OVERLAP_SECONDS=1.5
# AUDIO_FUNASR_DEVICE=auto
# AUDIO_TRANSLATION_PROVIDER=auto
# GEMINI_API_KEY=
# GEMINI_TRANSLATION_MODEL=gemini-2.5-flash
# GEMINI_TRANSLATION_MIN_REQUEST_INTERVAL_SECONDS=13
# Operator dialogue prompt (file under apps/api/prompts/; relative path also resolves from api root):
# AUDIO_TRANSLATION_USER_PROMPT_FILE=prompts/translation_user.txt
# OLLAMA_TRANSLATION_ENABLED=false
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TRANSLATION_MODEL=qwen2.5:7b
# TTS (SYNTHESIZE_TTS): immutable recipe/Ops profile is authority; these are fallbacks.
# Install edge: pip install edge-tts + ffmpeg on PATH.
# Install VieNeu: pip install vieneu
# AUDIO_TTS_PROVIDER=omnivoice
# AUDIO_TTS_VOICE_ID=instruct:vi_female_north
# AUDIO_TTS_MODEL_ID=k2-fsa/OmniVoice
# AUDIO_TTS_FALLBACK_PROVIDER=edge
