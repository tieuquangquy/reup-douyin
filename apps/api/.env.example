APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
# Phase 2 media_pipeline.ocr_filtering — PaddleOCR /predict (Local or Cloud).
# Same REST contract either way: POST multipart JPEG → JSON [{bbox,text,score}].
# Switch backend by changing OCR_ENDPOINT_URL only (restart API/worker after change).
#
# --- LOCAL (default for $0 / offline) ---
# Start container (tries PaddleOCR-VL-1.6, falls back to classic on OOM):
#   powershell -ExecutionPolicy Bypass -File deploy/hf-paddle-ocr/run_local.ps1
# Force classic only:  ... run_local.ps1 -Engine classic
# Phase 2 v58 standalone uses these local-only settings by default:
# LOCAL_OCR_ENDPOINT_URL=http://127.0.0.1:8080/predict
# Recommended for CPU hosts below 20 GiB RAM; must match the local container.
# LOCAL_OCR_MODEL_VERSION=ppocrv6-medium-det-rec
# Legacy E2E local endpoint setting:
# OCR_ENDPOINT_URL=http://127.0.0.1:8080/predict
# Container env: OCR_PADDLE_ENGINE=auto|vl16|classic  OCR_PADDLE_VL_DEVICE=cpu|gpu
# auto (recommended): classic on low Docker RAM; VL-1.6 when MemTotal >= 20GiB
#
# --- CLOUD (optional upgrade / backup) ---
# Deploy: python deploy/hf-paddle-ocr/auto_deploy.py
# Keep min-instances=0 when idle to avoid burn. Warm only while working: --warm
# OCR_ENDPOINT_URL=https://paddle-ocr-api-xxxxx-xx.a.run.app/predict
# OCR_MODEL_VERSION=ppocr-cloud-v1
#
# OCR_FILTERING_USE_MOCK=true
#
# --- Legacy Analyze OCR E2E profile (not v58 standalone Phase 2) ---
# OCR_QUALITY_PROFILE=best
# OCR_PREPROCESS_MAX_EDGE=1920
# OCR_JPEG_QUALITY=92
# OCR_ASYNC_CONCURRENCY=2
# OCR_CROP_BAND=1
# OCR_FRAME_BACKEND=text_onnx
# SKE crop OCR (Prompt 1+2): OCR_FRAME_BACKEND=ske  (empty/fail → text_onnx; ignored when OCR_QUALITY_PROFILE=best)
#
# --- Lighter / dev ---
# OCR_PREPROCESS_MAX_EDGE=1280
# OCR_ASYNC_CONCURRENCY=2
# OCR_HTTP_CONCURRENCY=4
# OCR_PROBE_STRIDE=2
# OCR_PROBE_EARLY_EXIT=1
# OCR_HTTP_TIMEOUT_SECONDS=300
# Rollback render: OCR_RENDER_BACKEND=ffmpeg_delogo (default opencv_inpaint)

# Phase A local operator auth â€” register once, then login.
# Table: operators (alembic 0028). Default workspace slug alias: local-workspace â†’ local.

# Phase 2.5 media_pipeline.translator â€” Ops Caption AI settings (caption_ai / caption_prompt).
# UI: Ops Console â†’ Caption AI settings. KhÃ´ng dÃ¹ng Translation settings (thoáº¡i).
# Env LLM_* chá»‰ khi Caption AI override Táº®T.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# TRANSLATION_SYSTEM_PROMPT=
DATABASE_URL=postgresql://reup_douyin:reup_douyin@localhost:5432/reup_douyin
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_STORAGE_ROOT=../../data/storage
# Optional override. Empty uses docs/pipeline-recipes/pipeline_recipe_current.json
# and binds auto queue runs to its content-addressed V24.1 artifact.
PIPELINE_RECIPE_LOCK_PATH=
LOG_LEVEL=INFO
API_AUTH_REQUIRED=true
JWT_SECRET_KEY=local-dev-insecure-change-me
JWT_ISSUER=reup-douyin
JWT_AUDIENCE=reup-douyin-web
JWT_WEB_AUDIENCE=reup-douyin-web
JWT_API_AUDIENCE=reup-douyin-api
JWT_OPS_AUDIENCE=reup-douyin-ops
# Login surfaces:
# - Operator Studio: http://localhost:3000/auth/login  (client=operator)
# - Ops Console:     http://localhost:3000/auth/ops/login  (client=ops, owner/admin only)
# - Swagger tooling: http://127.0.0.1:8000/auth/ui  (client=api-ui, read-only)
# Phase B session hardening
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_API_UI_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_OPS_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_REGISTRATION_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_INVITE_TTL_DAYS=7
# Required when APP_ENV=production. Must point to a KMS/HSM/provider key after
# apps/api/src/services/secret_envelope.py is wired to real envelope encryption.
DOUYIN_SECRET_ENCRYPTION_KEY_REF=

# Douyin live profile fetch is off by default so local/demo flows can use
# already-ingested data or adapter_payload_json fixtures without network access.
DOUYIN_ENABLE_LIVE_FETCH=false
DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
DOUYIN_SESSION_COOKIE=
DOUYIN_PROXY_URL=
DOUYIN_FETCH_TIMEOUT_SECONDS=15
DOUYIN_FETCH_MAX_VIDEOS=50
DOUYIN_YT_DLP_ENABLED=true
DOUYIN_YT_DLP_BINARY=yt-dlp
DOUYIN_YT_DLP_FORMAT=bestvideo*+bestaudio/best
DOUYIN_YT_DLP_TIMEOUT_SECONDS=180
# Prefer cookie store / live cookies for downloads. Cookie store is shared at repo
# .douyin_profiles/download_cookies (not cwd-relative LOCAL_STORAGE_ROOT).
# Download path is cookie-store-first (yt-dlp headless); Playwright is fallback only.
# Refresh session: open app-managed Douyin Chromium, log in once (cookies flush to store), then download with browser closed.
DOUYIN_YT_DLP_PREFER_BROWSER_COOKIES=true
# Optional override:
# DOUYIN_DOWNLOAD_COOKIE_STORE_DIR=
# Playwright Douyin download fallback when cookie-store yt-dlp fails. Worker may call API loopback.
# Auto-open runs headless by default so Start processing does not flash a Chromium window.
DOUYIN_PLAYWRIGHT_DOWNLOAD_ENABLED=true
DOUYIN_PLAYWRIGHT_DOWNLOAD_AUTO_OPEN=true
DOUYIN_PLAYWRIGHT_DOWNLOAD_HEADLESS=true
# Strict HQ/no-logo (default): prefer bit_rate/play_addr (Douyin download_addr usually has logo).
# Set true only if you explicitly accept Douyin logo overlays.
DOUYIN_DOWNLOAD_ALLOW_WATERMARKED_FALLBACK=false
DOUYIN_PLAYWRIGHT_DOWNLOAD_TIMEOUT_MS=90000
DOUYIN_DOWNLOAD_API_BASE_URL=http://127.0.0.1:8000
# DOWNLOAD_VIDEO auto-retry policy (transient vs auth vs terminal).
# DOUYIN_DOWNLOAD_TRANSIENT_MAX_ATTEMPTS=8
# DOUYIN_DOWNLOAD_AUTH_MAX_ATTEMPTS=2
# DOUYIN_DOWNLOAD_RETRY_BACKOFF_BASE_SECONDS=5
# DOUYIN_DOWNLOAD_RETRY_BACKOFF_MAX_SECONDS=120
# Hard cap for Reup Queue batch Start processing / Start auto. Default 30; soft max ~100.
REUP_QUEUE_START_PROCESSING_BATCH_LIMIT=30
# Max DOWNLOAD_VIDEO jobs RUNNING per workspace (prevents auto batch download storms). Default 1.
DOWNLOAD_VIDEO_MAX_CONCURRENT_RUNNING=1
# Requeue RUNNING downloads stuck longer than N seconds (hung register_assets / 71% guard).
# Leave unset to auto-derive from Playwright + yt-dlp budgets (>= 600s).
# DOWNLOAD_VIDEO_STALE_RUNNING_SECONDS=600
# Running-job caps per workspace for the heavy localization stages (one machine, Phase 1).
ANALYZE_AUDIO_MAX_CONCURRENT_RUNNING=1
SYNTHESIZE_TTS_MAX_CONCURRENT_RUNNING=2
ANALYZE_OCR_MAX_CONCURRENT_RUNNING=1
RENDER_FINAL_MAX_CONCURRENT_RUNNING=1
METRICS_COLLECTION_MAX_CONCURRENT_RUNNING=2
CLASSIFICATION_MAX_CONCURRENT_RUNNING=2
# Shared budget across every stage that loads a model/encoder onto the GPU. Per-type caps
# alone still let OCR + TTS + render collide on one card and OOM.
GPU_MAX_CONCURRENT_RUNNING=1
# Even out perceived volume across the batch (single-pass EBU R128 loudnorm at render).
RENDER_LOUDNESS_NORMALIZATION_ENABLED=true
RENDER_LOUDNESS_TARGET_LUFS=-14.0
RENDER_BACKGROUND_MIX_GAIN=1.0
# H.264 encoder policy: auto | libx264 | h264_nvenc | h264_qsv | h264_videotoolbox.
# auto runs a real smoke encode; failed hardware initialization falls back to libx264.
RENDER_VIDEO_ENCODER=auto
RENDER_HARDWARE_ENCODER_SMOKE_PROBE=true
RENDER_HARDWARE_ENCODER_FALLBACK_ENABLED=true
# Reclaim regenerable intermediates (stems, extracted audio, TTS clips, OCR frames) from clips
# that finished with a deliverable. Off by default because deleting media is unforgiving.
ARTIFACT_RETENTION_ENABLED=false
ARTIFACT_RETENTION_MIN_AGE_HOURS=24
# The cleaned (hardsub-removed) video is the biggest win, but some flows re-render from it.
ARTIFACT_RETENTION_INCLUDE_CLEANED_VIDEO=false
ARTIFACT_RETENTION_SWEEP_INTERVAL_SECONDS=900
# Free space required on the storage volume before a heavy media job starts. ffmpeg does not
# fail cleanly on a full disk — it writes a truncated file that looks like a success. Set 0 to disable.
MIN_FREE_DISK_GB=10
# How many clips the auto lane keeps moving at once. Extra Start-auto clips queue and are
# admitted automatically as slots free up, so videos finish in a steady stream.
REUP_MAX_ITEMS_IN_FLIGHT=5
# A running job refreshes its lock every N seconds; "stale" then means no heartbeat.
JOB_HEARTBEAT_SECONDS=30
PHASE1_NO_PROGRESS_TIMEOUT_SECONDS=300
# Dense 2K/4K sources can spend several minutes reconciling thousands of
# detections after the frame scan. This timeout applies only to postprocess.
PHASE1_POSTPROCESS_NO_PROGRESS_TIMEOUT_SECONDS=1200
# Keep cpu for the locked baseline. Set directml/cuda only after installing the matching
# ONNX Runtime build and passing geometry regression on this machine.
DBNET_ONNX_PROVIDER=cpu
# Lock age without a heartbeat before a RUNNING job is requeued, per job type. Media stages
# legitimately run for tens of minutes — judging them by the download budget kills healthy work.
ANALYZE_AUDIO_STALE_RUNNING_SECONDS=2700
BUILD_TRANSLATION_DRAFT_STALE_RUNNING_SECONDS=1800
SYNTHESIZE_TTS_STALE_RUNNING_SECONDS=2700
ANALYZE_OCR_STALE_RUNNING_SECONDS=5400
RENDER_PREVIEW_STALE_RUNNING_SECONDS=3600
RENDER_FINAL_STALE_RUNNING_SECONDS=5400
METRICS_COLLECTION_STALE_RUNNING_SECONDS=300
CLASSIFICATION_STALE_RUNNING_SECONDS=1800
JOB_STALE_RUNNING_SECONDS_DEFAULT=1800
# Auto-retry budget for transient failures in stages after download (timeouts, busy files, 5xx).
PIPELINE_TRANSIENT_MAX_ATTEMPTS=3
PIPELINE_RETRY_BACKOFF_BASE_SECONDS=15
PIPELINE_RETRY_BACKOFF_MAX_SECONDS=300
METRICS_COLLECTION_RETRY_BACKOFF_BASE_SECONDS=60
METRICS_COLLECTION_RETRY_BACKOFF_MAX_SECONDS=3600
METRICS_COLLECTION_RATE_LIMIT_COOLDOWN_SECONDS=900
METRICS_SCHEDULER_ENABLED=true
METRICS_SCHEDULER_SWEEP_INTERVAL_SECONDS=60
METRICS_SCHEDULER_DISPATCH_LIMIT=20

# Localization audio analysis (free stack). Optional â€” without FunASR/Gemini/Ollama,
# ANALYZE_AUDIO uses segmented caption STT + placeholder Vietnamese draft.
# AUDIO_STT_PROVIDER=funasr
# First FunASR model download can take several minutes; after this cap, fall back to caption STT.
# AUDIO_FUNASR_TIMEOUT_SECONDS=900
# Translation: Gemini (AI Studio key) primary; MyMemory only if Gemini down / CJK repair.
# Preferred Ops UI for provider/model/key: /ops/translation-ai (DB override wins over these env vars).
# AUDIO_TRANSLATION_PROVIDER=gemini
# Gemini free-tier runs sequentially; paid/local providers may raise this after load testing.
# AUDIO_TRANSLATION_MAX_CONCURRENCY=1
# GEMINI_API_KEY=
# Models (AI Studio): gemini-2.5-pro (best meaning) | gemini-2.5-flash / gemini-2.0-flash (faster, freer quota)
# GEMINI_TRANSLATION_MODEL=gemini-2.5-pro
# GEMINI_TRANSLATION_MIN_REQUEST_INTERVAL_SECONDS=13
# OLLAMA_TRANSLATION_ENABLED=false
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TRANSLATION_MODEL=qwen2.5:14b
# Your dialogue-translation system prompt (constant). App appends "Chinese source:" + beat text.
# Prefer the file for long prompts. Set the same values in apps/worker/.env and restart worker.
# AUDIO_TRANSLATION_USER_PROMPT_FILE=prompts/translation_user.txt
# AUDIO_TRANSLATION_USER_PROMPT=
# TTS: auto (prefer vieneu then edge-tts) | edge | vieneu | google | azure | elevenlabs |
# openai | openai_compatible | http_custom | cli | placeholder.
# Workspace Ops â†’ TTS active profile is authority for Generate TTS; these are env fallbacks.
# Requires for edge: pip install edge-tts + ffmpeg on PATH.
# Requires for vieneu: pip install vieneu (first run downloads models).
# AUDIO_TTS_PROVIDER=auto
# AUDIO_TTS_VOICE_ID=vi-VN-HoaiMyNeural
# AUDIO_TTS_SPEAKING_RATE=1.0
# AUDIO_TTS_FALLBACK_PROVIDER=edge
# AUDIO_TTS_API_KEY=
# AUDIO_TTS_BASE_URL=
# AUDIO_TTS_MODEL_ID=
# AUDIO_TTS_LOCAL_BACKEND=auto
# AUDIO_TTS_DEVICE=auto
# AUDIO_TTS_TIMEOUT_SECONDS=120
# Allow Ops Console one-click pip install into this Python env (allowlisted only).
# AUDIO_TTS_ALLOW_INSTALL=true
# AUDIO_TTS_ENGINE_ROOT=./data/tts-engines

DOUYIN_PERSISTENT_BROWSER_PROFILE_ENABLED=true
DOUYIN_PERSISTENT_BROWSER_PROFILES_ROOT_DIR=./data/browser-profiles/douyin
DOUYIN_PREFER_BROWSER_PROFILE_FOR_VALIDATION=true
DOUYIN_PREFER_BROWSER_PROFILE_FOR_FETCH=true
# Legacy Douyin paths stay disabled by default. Enable only for explicit
# debugging/migration sessions; the primary runtime is browser-profile-backed.
DOUYIN_ENABLE_LEGACY_MANUAL_IMPORT=false
DOUYIN_ENABLE_LEGACY_HTTP_FALLBACK=false
DOUYIN_ENABLE_LEGACY_DEBUG_SURFACES=false
# Compatibility alias for older intake fallback configuration. Keep false unless
# DOUYIN_ENABLE_LEGACY_HTTP_FALLBACK is also intentionally enabled.
DOUYIN_ALLOW_LEGACY_HTTP_FALLBACK_FOR_INTAKE=false
DOUYIN_PERSISTENT_BROWSER_CONTEXT_ENABLED=true
DOUYIN_REUSE_LIVE_BROWSER_FOR_VALIDATION=true
DOUYIN_REUSE_LIVE_BROWSER_FOR_FETCH=true
DOUYIN_BROWSER_CONTEXT_IDLE_TIMEOUT_SECONDS=1800
DOUYIN_BROWSER_CONTEXT_MAX_LIFETIME_SECONDS=14400
DOUYIN_BROWSER_CONNECT_STABILIZATION_SECONDS=8
DOUYIN_INTAKE_PREFLIGHT_CACHE_TTL_SECONDS=30
DOUYIN_BROWSER_PROFILE_FETCH_SCROLL_PASSES=4
DOUYIN_BROWSER_PROFILE_FETCH_SETTLE_SECONDS=2

# Required only for real Facebook Page/Reels publish attempts.
# Do not commit real page access tokens.
FACEBOOK_PAGE_ACCESS_TOKEN=

# Break-glass fallback for Meta OAuth. Normal local setup is saved from
# Ops > Accounts; App Secret is encrypted and never uses NEXT_PUBLIC_* names.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/publishing/accounts
FACEBOOK_GRAPH_API_VERSION=v20.0
FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement,read_insights,pages_manage_posts
FACEBOOK_OAUTH_SESSION_TTL_MINUTES=10
FACEBOOK_OAUTH_REQUEST_TIMEOUT_SECONDS=20
# Generate 32 random bytes, then store as: base64:<base64 value>
PLATFORM_CREDENTIAL_ENCRYPTION_KEY_REF=
# Local mode auto-generates this server-only file on the first UI save when no
# external key ref is configured. Production never auto-generates a key.
PLATFORM_CREDENTIAL_LOCAL_KEY_PATH=./data/secrets/platform-credentials.key
FACEBOOK_PUBLISH_GUARDRAILS_ENABLED=true
FACEBOOK_PUBLISH_REQUIRE_VERIFIED_CAPABILITY=true
FACEBOOK_PUBLISH_CAPABILITY_MAX_AGE_DAYS=30
FACEBOOK_PUBLISH_MAX_CONCURRENT_PER_ACCOUNT=1
FACEBOOK_PUBLISH_MIN_INTERVAL_MINUTES=60
FACEBOOK_PUBLISH_MAX_ATTEMPTS_PER_24H=6
FACEBOOK_PUBLISH_MAX_FAILURES_PER_24H=2
FACEBOOK_PUBLISH_WARMUP_DAYS=7
FACEBOOK_PUBLISH_WARMUP_MIN_INTERVAL_MINUTES=360
FACEBOOK_PUBLISH_WARMUP_MAX_ATTEMPTS_PER_24H=2
FACEBOOK_PUBLISH_OBSERVE_MIN_AGE_HOURS=48
FACEBOOK_PUBLISH_OBSERVE_MIN_SUCCESSES=2
FACEBOOK_PUBLISH_OBSERVE_MIN_INTERVAL_MINUTES=180
FACEBOOK_PUBLISH_OBSERVE_MAX_ATTEMPTS_PER_24H=3
FACEBOOK_PUBLISH_STANDARD_MIN_SUCCESSES=5
FACEBOOK_PUBLISH_RATE_LIMIT_COOLDOWN_MINUTES=360
