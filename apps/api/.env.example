APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
# Phase 2 media_pipeline.ocr_filtering — Cloud Run PaddleOCR /predict.
# Written automatically by: python deploy/hf-paddle-ocr/auto_deploy.py
# OCR_ENDPOINT_URL=https://paddle-ocr-api-xxxxx-xx.a.run.app/predict
# OCR_FILTERING_USE_MOCK=true
# Dense UI / small glyphs: default client max edge is 1280 (override if needed).
# OCR_PREPROCESS_MAX_EDGE=1280
# Perf defaults (omit = on / 4 / 2 / on):
# OCR_CROP_BAND=1
# OCR_HTTP_CONCURRENCY=4
# OCR_PROBE_STRIDE=2
# OCR_PROBE_EARLY_EXIT=1
# OCR_HTTP_TIMEOUT_SECONDS=300
# Rollback render: OCR_RENDER_BACKEND=ffmpeg_delogo (default opencv_inpaint)

# Phase A local operator auth — register once, then login.
# Table: operators (alembic 0028). Default workspace slug alias: local-workspace → local.

# Phase 2.5 media_pipeline.translator — Ops Caption AI settings (caption_ai / caption_prompt).
# UI: Ops Console → Caption AI settings. Không dùng Translation settings (thoại).
# Env LLM_* chỉ khi Caption AI override TẮT.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# TRANSLATION_SYSTEM_PROMPT=
DATABASE_URL=postgresql://reup_douyin:reup_douyin@localhost:5432/reup_douyin
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_STORAGE_ROOT=../../data/storage
LOG_LEVEL=INFO
API_AUTH_REQUIRED=true
JWT_SECRET_KEY=local-dev-insecure-change-me
JWT_ISSUER=reup-douyin
JWT_AUDIENCE=reup-douyin-web
JWT_WEB_AUDIENCE=reup-douyin-web
JWT_API_AUDIENCE=reup-douyin-api
JWT_OPS_AUDIENCE=reup-douyin-ops
# Login surfaces:
# - Operator Studio: http://localhost:3000/auth/login  (client=operator)
# - Ops Console:     http://localhost:3000/auth/ops/login  (client=ops, owner/admin only)
# - Swagger tooling: http://127.0.0.1:8000/auth/ui  (client=api-ui, read-only)
# Phase B session hardening
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_API_UI_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_OPS_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_REGISTRATION_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_INVITE_TTL_DAYS=7
# Required when APP_ENV=production. Must point to a KMS/HSM/provider key after
# apps/api/src/services/secret_envelope.py is wired to real envelope encryption.
DOUYIN_SECRET_ENCRYPTION_KEY_REF=

# Douyin live profile fetch is off by default so local/demo flows can use
# already-ingested data or adapter_payload_json fixtures without network access.
DOUYIN_ENABLE_LIVE_FETCH=false
DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
DOUYIN_SESSION_COOKIE=
DOUYIN_PROXY_URL=
DOUYIN_FETCH_TIMEOUT_SECONDS=15
DOUYIN_FETCH_MAX_VIDEOS=50
DOUYIN_YT_DLP_ENABLED=true
DOUYIN_YT_DLP_BINARY=yt-dlp
DOUYIN_YT_DLP_FORMAT=bestvideo*+bestaudio/best
DOUYIN_YT_DLP_TIMEOUT_SECONDS=180
# Prefer cookie store / live cookies for downloads. Cookie store is shared at repo
# .douyin_profiles/download_cookies (not cwd-relative LOCAL_STORAGE_ROOT).
# Download path is cookie-store-first (yt-dlp headless); Playwright is fallback only.
# Refresh session: open app-managed Douyin Chromium, log in once (cookies flush to store), then download with browser closed.
DOUYIN_YT_DLP_PREFER_BROWSER_COOKIES=true
# Optional override:
# DOUYIN_DOWNLOAD_COOKIE_STORE_DIR=
# Playwright Douyin download fallback when cookie-store yt-dlp fails. Worker may call API loopback.
# Auto-open runs headless by default so Start processing does not flash a Chromium window.
DOUYIN_PLAYWRIGHT_DOWNLOAD_ENABLED=true
DOUYIN_PLAYWRIGHT_DOWNLOAD_AUTO_OPEN=true
DOUYIN_PLAYWRIGHT_DOWNLOAD_HEADLESS=true
# Strict HQ/no-logo (default): prefer bit_rate/play_addr (Douyin download_addr usually has logo).
# Set true only if you explicitly accept Douyin logo overlays.
DOUYIN_DOWNLOAD_ALLOW_WATERMARKED_FALLBACK=false
DOUYIN_PLAYWRIGHT_DOWNLOAD_TIMEOUT_MS=90000
DOUYIN_DOWNLOAD_API_BASE_URL=http://127.0.0.1:8000
# DOWNLOAD_VIDEO auto-retry policy (transient vs auth vs terminal).
# DOUYIN_DOWNLOAD_TRANSIENT_MAX_ATTEMPTS=8
# DOUYIN_DOWNLOAD_AUTH_MAX_ATTEMPTS=2
# DOUYIN_DOWNLOAD_RETRY_BACKOFF_BASE_SECONDS=5
# DOUYIN_DOWNLOAD_RETRY_BACKOFF_MAX_SECONDS=120
# Hard cap for Reup Queue batch Start processing. Default 30; soft max ~100.
REUP_QUEUE_START_PROCESSING_BATCH_LIMIT=30

# Localization audio analysis (free stack). Optional — without FunASR/Gemini/Ollama,
# ANALYZE_AUDIO uses segmented caption STT + placeholder Vietnamese draft.
# AUDIO_STT_PROVIDER=funasr
# First FunASR model download can take several minutes; after this cap, fall back to caption STT.
# AUDIO_FUNASR_TIMEOUT_SECONDS=900
# Translation: Gemini (AI Studio key) primary; MyMemory only if Gemini down / CJK repair.
# Preferred Ops UI for provider/model/key: /ops/translation-ai (DB override wins over these env vars).
# AUDIO_TRANSLATION_PROVIDER=gemini
# Bounded parallelism for Translate (beats in parallel). Default 4. Lower on Gemini 429.
# AUDIO_TRANSLATION_MAX_CONCURRENCY=4
# GEMINI_API_KEY=
# Models (AI Studio): gemini-2.5-pro (best meaning) | gemini-2.5-flash / gemini-2.0-flash (faster, freer quota)
# GEMINI_TRANSLATION_MODEL=gemini-2.5-pro
# OLLAMA_TRANSLATION_ENABLED=false
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TRANSLATION_MODEL=qwen2.5:14b
# Your dialogue-translation system prompt (constant). App appends "Chinese source:" + beat text.
# Prefer the file for long prompts. Set the same values in apps/worker/.env and restart worker.
# AUDIO_TRANSLATION_USER_PROMPT_FILE=prompts/translation_user.txt
# AUDIO_TRANSLATION_USER_PROMPT=
# TTS: auto (prefer vieneu then edge-tts) | edge | vieneu | google | azure | elevenlabs |
# openai | openai_compatible | http_custom | cli | placeholder.
# Workspace Ops → TTS settings overrides these when enabled.
# Requires for edge: pip install edge-tts + ffmpeg on PATH.
# Requires for vieneu: pip install vieneu (first run downloads models).
# AUDIO_TTS_PROVIDER=auto
# AUDIO_TTS_VOICE_ID=vi-VN-HoaiMyNeural
# AUDIO_TTS_SPEAKING_RATE=1.0
# AUDIO_TTS_FALLBACK_PROVIDER=edge
# AUDIO_TTS_API_KEY=
# AUDIO_TTS_BASE_URL=
# AUDIO_TTS_MODEL_ID=
# AUDIO_TTS_LOCAL_BACKEND=auto
# AUDIO_TTS_DEVICE=auto
# AUDIO_TTS_TIMEOUT_SECONDS=120
# Allow Ops Console one-click pip install into this Python env (allowlisted only).
# AUDIO_TTS_ALLOW_INSTALL=true

DOUYIN_PERSISTENT_BROWSER_PROFILE_ENABLED=true
DOUYIN_PERSISTENT_BROWSER_PROFILES_ROOT_DIR=./data/browser-profiles/douyin
DOUYIN_PREFER_BROWSER_PROFILE_FOR_VALIDATION=true
DOUYIN_PREFER_BROWSER_PROFILE_FOR_FETCH=true
# Legacy Douyin paths stay disabled by default. Enable only for explicit
# debugging/migration sessions; the primary runtime is browser-profile-backed.
DOUYIN_ENABLE_LEGACY_MANUAL_IMPORT=false
DOUYIN_ENABLE_LEGACY_HTTP_FALLBACK=false
DOUYIN_ENABLE_LEGACY_DEBUG_SURFACES=false
# Compatibility alias for older intake fallback configuration. Keep false unless
# DOUYIN_ENABLE_LEGACY_HTTP_FALLBACK is also intentionally enabled.
DOUYIN_ALLOW_LEGACY_HTTP_FALLBACK_FOR_INTAKE=false
DOUYIN_PERSISTENT_BROWSER_CONTEXT_ENABLED=true
DOUYIN_REUSE_LIVE_BROWSER_FOR_VALIDATION=true
DOUYIN_REUSE_LIVE_BROWSER_FOR_FETCH=true
DOUYIN_BROWSER_CONTEXT_IDLE_TIMEOUT_SECONDS=1800
DOUYIN_BROWSER_CONTEXT_MAX_LIFETIME_SECONDS=14400
DOUYIN_BROWSER_CONNECT_STABILIZATION_SECONDS=8
DOUYIN_INTAKE_PREFLIGHT_CACHE_TTL_SECONDS=30
DOUYIN_BROWSER_PROFILE_FETCH_SCROLL_PASSES=4
DOUYIN_BROWSER_PROFILE_FETCH_SETTLE_SECONDS=2

# Required only for real Facebook Page/Reels publish attempts.
# Do not commit real page access tokens.
FACEBOOK_PAGE_ACCESS_TOKEN=
